# Application
APP_ENV=local
APP_NAME=VAI Business Development Decision Intelligence
APP_VERSION=0.1.0.dev0

# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://vai_bd:vai_bd@localhost:5432/vai_bd

# OpenAI specialist runtime (not used by default tests)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_AGENTS_DISABLE_TRACING=0
TRACE_INCLUDE_SENSITIVE_DATA=0

# Governance boundary: must remain false for test and conformity profiles.
EXTERNAL_EXECUTION_ALLOWED=false

# Local/test authentication only; not a production identity provider.
TEST_AUTH_SIGNING_KEY=

